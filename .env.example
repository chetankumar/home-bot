# Copy to .env and fill in. Never commit .env.

# Login password for the hub (single user).
HUB_PASSWORD=change-me

# Signs the session cookie and encrypts stored OAuth tokens. Changing it logs
# you out and makes stored tokens unreadable (you'd reconnect Google).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_SECRET_KEY=

# Where the hub is reached for the one-time Google consent (must be localhost or https).
HUB_BASE_URL=http://localhost:8000

# AI provider keys (leave blank for providers you don't use).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Google OAuth "Web application" client (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
